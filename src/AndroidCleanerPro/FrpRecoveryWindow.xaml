<Window x:Class="AndroidCleanerPro.FrpRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FRP Recovery Assistant | Android Cleaner Pro"
        Width="900" Height="730" MinWidth="740" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111E32" BorderBrush="#2A3D5C"
                BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock Text="OWNER-VERIFIED ACCOUNT RECOVERY" Foreground="#60A5FA"
                           FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Factory Reset Protection (FRP)" FontSize="26"
                           FontWeight="Bold" Margin="0,8,0,5"/>
                <TextBlock Text="Official recovery guidance for locked Android devices — not an FRP bypass or unlocking tool."
                           Foreground="#AFC1D5" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,22,25,15">
                <Border Background="#17263B" CornerRadius="11" Padding="17" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Device and situation" Foreground="#60A5FA"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Manufacturer" Margin="0,0,0,7"/>
                                <ComboBox x:Name="BrandBox" Height="34" Background="#F8FAFC"
                                          Foreground="#0F172A" SelectionChanged="Selection_Changed">
                                    <ComboBoxItem Content="Samsung"/>
                                    <ComboBoxItem Content="Motorola"/>
                                    <ComboBoxItem Content="Google Pixel"/>
                                    <ComboBoxItem Content="Other Android"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Current situation" Margin="0,0,0,7"/>
                                <ComboBox x:Name="SituationBox" Height="34" Background="#F8FAFC"
                                          Foreground="#0F172A" SelectionChanged="Selection_Changed">
                                    <ComboBoxItem Content="Locked after reset"/>
                                    <ComboBoxItem Content="Forgot Google password"/>
                                    <ComboBoxItem Content="Forgot Google account email"/>
                                    <ComboBoxItem Content="Preparing phone for sale or repair"/>
                                    <ComboBoxItem Content="Purchased used / previous owner unavailable"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="This assistant does not read or store Google credentials, account names, IMEI numbers or phone contents."
                                   Foreground="#94A3B8" FontSize="12" Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#17263B" CornerRadius="11" Padding="17" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Technician intake checklist" Foreground="#60A5FA"
                                   FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                        <CheckBox x:Name="OwnerCheck" Foreground="#E2E8F0" Margin="0,0,0,10"
                                  Checked="Checklist_Changed" Unchecked="Checklist_Changed">
                            <TextBlock TextWrapping="Wrap" MaxWidth="720">
                                The device owner or their authorized representative is present and has consented to the service.
                            </TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="PurchaseCheck" Foreground="#E2E8F0" Margin="0,0,0,10"
                                  Checked="Checklist_Changed" Unchecked="Checklist_Changed">
                            <TextBlock TextWrapping="Wrap" MaxWidth="720">
                                Ownership documentation or a traceable purchase record has been reviewed, where available.
                            </TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="NoCredentialsCheck" Foreground="#E2E8F0"
                                  Checked="Checklist_Changed" Unchecked="Checklist_Changed">
                            <TextBlock TextWrapping="Wrap" MaxWidth="720">
                                I will not ask the customer to reveal passwords or 2-step verification codes to this application.
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Background="#17263B" CornerRadius="11" Padding="17" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Recommended next steps" Foreground="#60A5FA"
                                   FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                        <TextBlock x:Name="GuidanceText" TextWrapping="Wrap" LineHeight="23"
                                   FontSize="13"/>
                        <TextBlock x:Name="BrandNoteText" TextWrapping="Wrap"
                                   Foreground="#FBBF24" Margin="0,12,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Background="#17263B" CornerRadius="11" Padding="17">
                    <StackPanel>
                        <TextBlock Text="Official recovery resources" Foreground="#60A5FA"
                                   FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="Google Account Recovery" Style="{StaticResource ActionButton}"
                                    Click="GoogleRecovery_Click"/>
                            <Button Content="Google FRP Guidance" Style="{StaticResource ActionButton}"
                                    Background="#334155" Click="GoogleFrp_Click"/>
                            <Button Content="Manufacturer Support" Style="{StaticResource ActionButton}"
                                    Background="#0F766E" Click="Manufacturer_Click"/>
                            <Button Content="Copy Steps (No Credentials)" Style="{StaticResource ActionButton}"
                                    Background="#334155" Click="Copy_Click"/>
                        </WrapPanel>
                        <TextBlock Text="If your customer's identity cannot be verified, stop and refer them to the seller, carrier or manufacturer. Reflashing or resetting the device is not a substitute for FRP account verification."
                                   Foreground="#AFC1D5" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#111E32" Padding="22,13"
                BorderBrush="#2A3D5C" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource ActionButton}"
                        Background="#334155" Margin="0" Click="Close_Click"/>
                <TextBlock x:Name="ChecklistStatus" Text="Review ownership and customer authorization first."
                           VerticalAlignment="Center" Foreground="#93A9C3" TextWrapping="Wrap"
                           Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>