<Window x:Class="AndroidCleanerPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Android Cleaner Pro | Technician Edition" Width="1200" Height="760" MinWidth="850" MinHeight="550" Background="#0B1220" Foreground="#E2E8F0" FontFamily="Segoe UI">
<Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2E8F0"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#111E32"/><Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="RowBackground" Value="#111E32"/><Setter Property="AlternatingRowBackground" Value="#17263B"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/></Style>
  <Style x:Key="SidebarNavButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#CBD5E1"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Margin" Value="0,0,0,9"/>
    <Setter Property="Padding" Value="13,12"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
</Window.Resources>
<DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
        <Menu Background="#101D30" Foreground="#F1F5F9" FontSize="13" Padding="8,4" BorderBrush="#2A3B54" BorderThickness="0,0,0,1">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                    <Setter Property="Background" Value="#101D30"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="_Export Visible App Report..." Click="Export_Click"/>
                <Separator/>
                <MenuItem Header="_Settings..." Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Device">
                <MenuItem Header="_Refresh Devices" Click="Refresh_Click"/>
                <MenuItem Header="Restart _ADB and Detect Phone" Click="RestartAdb_Click"/>
                <MenuItem Header="_Stop All ADB Services..." Click="StopAdb_Click"/>
                <Separator/>
                <MenuItem Header="Phone _Information..." Click="PhoneInfo_Click"/>
                <MenuItem Header="_Firmware / Fastboot Tools..." Click="Firmware_Click"/>
                <MenuItem Header="FRP _Recovery Assistant..." Click="FrpRecovery_Click"/>
                <MenuItem Header="Reboot into _Recovery..." Click="Recovery_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Scan Installed _Apps" Click="Scan_Click"/>
                <MenuItem Header="Detect _Adware / Popups..." Click="Adware_Click"/>
                <MenuItem Header="_Firmware / Fastboot Tools..." Click="Firmware_Click"/>
                <MenuItem Header="_Safe Mode Help..." Click="SafeMode_Click"/>
                <Separator/>
                <MenuItem Header="_Settings..." Click="Settings_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" Click="Documentation_Click"/>
                <MenuItem Header="Check for _Updates" Click="Update_Click"/>
                <Separator/>
                <MenuItem Header="_About Android Cleaner Pro" Click="About_Click"/>
            </MenuItem>
        </Menu>
        <Border Background="#132237" BorderBrush="#28405B" BorderThickness="0,0,0,1" Padding="12,7">
            <WrapPanel Orientation="Horizontal">
                <Button Content="↻  Refresh" Click="Refresh_Click" ToolTip="Find connected Android phones"
                        Background="#334155" Padding="12,7"/>
                <Button Content="▣  Phone Info" Click="PhoneInfo_Click" ToolTip="Detailed phone information"
                        Background="#334155" Padding="12,7"/>
                <Button Content="⬡  Adware Scan" Click="Adware_Click" ToolTip="Investigate suspicious apps and popups"
                        Background="#0F766E" Padding="12,7"/>
                <Button Content="⚡  Firmware Tools" Click="Firmware_Click" ToolTip="Read Fastboot device state and carefully flash verified images"
                        Background="#7C3AED" Padding="12,7"/>
                <Button Content="🔒  FRP Recovery" Click="FrpRecovery_Click" ToolTip="Owner-authorized Factory Reset Protection account recovery guidance"
                        Background="#334155" Padding="12,7"/>
                <Button Content="⚙  Settings" Click="Settings_Click" ToolTip="Configure ADB and update preferences"
                        Background="#334155" Padding="12,7"/>
                <Button Content="↑  Check Updates" Click="Update_Click" ToolTip="Check GitHub Releases for updates"
                        Background="#334155" Padding="12,7"/>
                <Button Content="ⓘ  About" Click="About_Click" ToolTip="Program information and resources"
                        Background="#334155" Padding="12,7"/>
            </WrapPanel>
        </Border>
    </StackPanel>
<Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111B2C" Grid.Column="0" Padding="20">
    <StackPanel>
      <TextBlock Text="◈ ANDROID CLEANER" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" Margin="0,12,0,5"/>
      <TextBlock Text="PRO • TECHNICIAN EDITION" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,38"/>
      <Button x:Name="DashboardNavButton" Style="{StaticResource SidebarNavButton}"
              Content="▣  Device Dashboard" Click="DashboardNav_Click"
              ToolTip="Connected Android devices and maintenance controls"/>
      <Button x:Name="InventoryNavButton" Style="{StaticResource SidebarNavButton}"
              Content="▦  App Inventory" Click="InventoryNav_Click"
              ToolTip="Inspect installed apps and filter by vendor or date"/>
      <Button x:Name="SecurityNavButton" Style="{StaticResource SidebarNavButton}"
              Content="⬡  Security Review" Click="SecurityNav_Click"
              ToolTip="Investigate popups, suspicious apps and security indicators"/>
      <Button x:Name="ReportsNavButton" Style="{StaticResource SidebarNavButton}"
              Content="↧  JSON Reports" Click="ReportsNav_Click"
              ToolTip="Export current filtered app inventory"/>
      <TextBlock x:Name="VersionText" Text="Native C# / WPF" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,260,0,0"/>
    </StackPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock x:Name="PageTitle" Text="Device Dashboard" FontSize="27" FontWeight="Bold"/>
        <TextBlock x:Name="PageSubtitle" Text="Connect an authorized Android device with USB debugging enabled"
                   Foreground="#94A3B8" Margin="0,7,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
    <Border x:Name="ConnectedDevicesPanel" Grid.Row="1" Background="#17263B" CornerRadius="12" Padding="18" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="CONNECTED DEVICES" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Refresh Devices" Click="Refresh_Click"/>
          <ComboBox x:Name="DeviceSelector" Height="34" Margin="0,0,12,0" Background="#F8FAFC" Foreground="#0F172A" DisplayMemberPath="Description" SelectionChanged="DeviceSelector_SelectionChanged"/>
        </DockPanel>
        <WrapPanel Margin="0,10,0,2" Orientation="Horizontal">
          <Button Content="Restart ADB + Detect Phone" Background="#0F766E" Click="RestartAdb_Click"/>
          <Button Content="Stop All ADB Services" Background="#9F1239" Click="StopAdb_Click"/>
        </WrapPanel>
        <TextBlock x:Name="DeviceDetails" Text="No device selected" Foreground="#E2E8F0" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="PhoneInfoText" Text="Connect a phone to view manufacturer, model, Android version, build, battery and storage." Foreground="#94A3B8" Margin="0,7,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <WrapPanel x:Name="MainActionsPanel" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
      <Button Content="Scan Installed Apps" Click="Scan_Click"/>
      <Button Content="Detect Adware / Popups" Background="#0F766E" Click="Adware_Click"/>
      <Button Content="Uninstall Selected" Background="#B91C1C" Click="Uninstall_Click"/>
      <Button Content="Export Visible JSON" Background="#334155" Click="Export_Click"/>
      <Button Content="Phone Info" Background="#334155" Click="PhoneInfo_Click"/>
      <Button Content="Firmware / Flashing" Background="#7C3AED" Click="Firmware_Click"/>
      <Button Content="FRP Recovery" Background="#334155" Click="FrpRecovery_Click"/>

      <Button Content="Reboot Recovery" Background="#7C3AED" Click="Recovery_Click"/>
      <Button Content="Safe Mode Help" Background="#334155" Click="SafeMode_Click"/>
      <Button Content="Check for Updates" Background="#0F766E" Click="Update_Click"/>
    </WrapPanel>
    <Border x:Name="InventoryFiltersPanel" Grid.Row="3" Background="#17263B" CornerRadius="10" Padding="12" Margin="0,0,0,11">
      <StackPanel>
        <TextBlock Text="APP INVENTORY FILTERS" Foreground="#93C5FD" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
        <WrapPanel Orientation="Horizontal">
          <StackPanel Margin="0,0,12,7">
            <TextBlock Text="Category" Foreground="#A2B4CC" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="InventoryCategoryFilter" Width="165" Height="31" SelectedIndex="0"
                      Background="#F8FAFC" Foreground="#0F172A"
                      SelectionChanged="InventoryFilter_Changed">
              <ComboBoxItem Content="All categories"/>
              <ComboBoxItem Content="Android / System"/>
              <ComboBoxItem Content="Google"/>
              <ComboBoxItem Content="Banking / Finance"/>
              <ComboBoxItem Content="Samsung"/>
              <ComboBoxItem Content="Motorola"/>
              <ComboBoxItem Content="T-Mobile / Metro"/>
              <ComboBoxItem Content="Other familiar vendors"/>
              <ComboBoxItem Content="Other apps"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,0,12,7">
            <TextBlock Text="App type" Foreground="#A2B4CC" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="InventoryTypeFilter" Width="125" Height="31" SelectedIndex="0"
                      Background="#F8FAFC" Foreground="#0F172A"
                      SelectionChanged="InventoryFilter_Changed">
              <ComboBoxItem Content="All apps"/>
              <ComboBoxItem Content="User apps"/>
              <ComboBoxItem Content="System apps"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,0,12,7">
            <TextBlock Text="First installed" Foreground="#A2B4CC" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="InventoryAgeFilter" Width="164" Height="31" SelectedIndex="0"
                      Background="#F8FAFC" Foreground="#0F172A"
                      SelectionChanged="InventoryFilter_Changed">
              <ComboBoxItem Content="Any date" Tag="all"/>
              <ComboBoxItem Content="Within 1 day" Tag="1"/>
              <ComboBoxItem Content="Within 2 days" Tag="2"/>
              <ComboBoxItem Content="Within 7 days" Tag="7"/>
              <ComboBoxItem Content="Within 30 days" Tag="30"/>
              <ComboBoxItem Content="Date unavailable" Tag="unknown"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Margin="0,0,12,7">
            <TextBlock Text="Search package" Foreground="#A2B4CC" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="InventorySearchBox" Width="180" Height="31" Padding="8,4"
                     Background="#F8FAFC" Foreground="#0F172A"
                     TextChanged="InventorySearch_Changed"/>
          </StackPanel>
        </WrapPanel>
        <WrapPanel Orientation="Horizontal">
          <CheckBox x:Name="HideFamiliarCheck" Content="Hide familiar vendor/system categories"
                    Foreground="#E2E8F0" Margin="0,0,14,4"
                    Checked="InventoryHide_Changed" Unchecked="InventoryHide_Changed"
                    ToolTip="Filtering is based on app names, not verified publisher identity or safety."/>
          <TextBlock x:Name="InventoryCountText" Text="No inventory scanned yet."
                     Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
        </WrapPanel>
        <TextBlock Text="Category labels are package-name clues, not proof an app is genuine or safe. Install dates come from Android, when reported."
                   Foreground="#8FA4C0" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <DataGrid x:Name="PackagesGrid" Grid.Row="4" AlternationCount="2" SelectionMode="Single"
              HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="App / Package" Binding="{Binding Name}" Width="230"/>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="165"/>
        <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="68"/>
        <DataGridTextColumn Header="First installed" Binding="{Binding InstalledLabel}" Width="145"/>
        <DataGridTextColumn Header="Last updated" Binding="{Binding UpdatedLabel}" Width="145"/>
        <DataGridTextColumn Header="Installer" Binding="{Binding Installer}" Width="180"/>
        <DataGridTextColumn Header="Review" Binding="{Binding Risk}" Width="80"/>
        <DataGridTextColumn Header="Notes" Binding="{Binding Reason}" Width="280"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border x:Name="SecurityReviewPanel" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed"
            Background="#17263B" CornerRadius="12" Padding="25" Margin="0,0,0,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Suspicious Apps and Adware Investigation" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <TextBlock Text="Review third-party app permissions, unusual installation sources, overlays and advertising-related indicators. Capturing a foreground window while an ad is visible can provide another clue."
                     TextWrapping="Wrap" Foreground="#A9BED8" Margin="0,0,0,20"/>
          <WrapPanel>
            <Button Content="Open Adware / Popup Scanner" Background="#0F766E"
                    Click="Adware_Click" Padding="18,12"/>
            <Button Content="Safe Mode Instructions" Background="#334155"
                    Click="SafeMode_Click" Padding="18,12"/>
          </WrapPanel>
          <TextBlock Text="Note: a flagged app is not necessarily malware. No app is automatically removed. Connect and authorize a device before starting the scanner."
                     Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border x:Name="ReportsPanel" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed"
            Background="#17263B" CornerRadius="12" Padding="25" Margin="0,0,0,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Inventory Reports" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="Export the scanned app inventory, including the currently selected vendor, system/user and installation-date filters. Reports are saved locally as JSON."
                     Foreground="#A9BED8" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <TextBlock x:Name="ReportsSummaryText" Text="No apps scanned yet."
                     Foreground="#BFDBFE" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <WrapPanel>
            <Button Content="Export Visible Apps to JSON…" Background="#0F766E"
                    Click="Export_Click" Padding="18,12"/>
            <Button Content="View and Filter Apps" Background="#334155"
                    Click="InventoryNav_Click" Padding="18,12"/>
          </WrapPanel>
          <TextBlock Text="The report may contain a device serial number and installed package names. Do not share customer diagnostics without permission. Only apps visible under your filters are included."
                     Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="#94A3B8" Margin="0,12,0,0" Text="Ready. Refresh devices to begin." TextWrapping="Wrap"/>
  </Grid>
</Grid>
</DockPanel>
</Window>