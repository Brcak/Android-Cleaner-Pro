<Window x:Class="AndroidCleanerPro.AdwareScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adware &amp; Suspicious Apps | Android Cleaner Pro"
        Width="1240" Height="800" MinWidth="980" MinHeight="610"
        WindowStartupLocation="CenterOwner" Background="#0B1220"
        Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2E8F0"/></Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#13243A"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="RowBackground" Value="#13243A"/>
            <Setter Property="AlternatingRowBackground" Value="#1B304A"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </Window.Resources>
    <Grid Margin="23,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="ADWARE &amp; SUSPICIOUS APPS" FontWeight="Bold" FontSize="25"/>
            <TextBlock x:Name="DeviceLabel" Foreground="#94A3B8" Margin="0,5,0,0"/>
            <TextBlock Text="Indicators are clues, not proof of malware. Normal apps can request these permissions. Nothing is automatically removed."
                       Foreground="#A4B8D3" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,5">
            <Button x:Name="StartScanButton" Style="{StaticResource ToolButton}" Content="Scan Third-Party Apps" Click="Scan_Click"/>
            <Button x:Name="CancelScanButton" Style="{StaticResource ToolButton}" Content="Cancel Scan" Background="#7C3AED" Click="Cancel_Click" IsEnabled="False"/>
            <Button x:Name="CaptureButton" Style="{StaticResource ToolButton}" Content="Who Is Showing This Ad? (Now)" Background="#0F766E" Click="Capture_Click"/>
            <Button x:Name="WatchButton" Style="{StaticResource ToolButton}" Content="Watch Foreground (15s)" Background="#0F766E" Click="Watch_Click"/>
            <Button x:Name="RemoveButton" Style="{StaticResource ToolButton}" Content="Uninstall Selected" Background="#B91C1C" Click="Remove_Click"/>
            <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" Content="Export Findings" Background="#334155" Click="Export_Click"/>
        </WrapPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <ProgressBar x:Name="ScanProgress" Height="7" Minimum="0" Maximum="100" Value="0"
                         Background="#1C3048" Foreground="#38BDF8"/>
            <TextBlock x:Name="StatusText" Foreground="#A4B8D3" Margin="0,7,0,0"
                       Text="Ready. Press Scan Third-Party Apps to inspect installed apps." TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="FindingsGrid" Grid.Column="0" AlternationCount="2" SelectionChanged="FindingsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="App package" Binding="{Binding Package}" Width="2*"/>
                    <DataGridTextColumn Header="Review priority" Binding="{Binding Priority}" Width="105"/>
                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="55"/>
                    <DataGridTextColumn Header="Indicators" Binding="{Binding Indicators}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Margin="12,0,0,0" Background="#162439" CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SELECTED APP EVIDENCE" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>
                        <TextBlock x:Name="SelectedPackage" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Installer" Foreground="#94A3B8" Margin="0,16,0,4"/>
                        <TextBlock x:Name="SelectedInstaller" TextWrapping="Wrap"/>
                        <TextBlock Text="Why it was flagged" Foreground="#94A3B8" Margin="0,16,0,4"/>
                        <TextBlock x:Name="SelectedExplanation" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="No automatic removals. Review app identity and behavior with the owner."
                                   Foreground="#94A3B8" TextWrapping="Wrap" FontSize="11" Margin="0,19,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#162439" CornerRadius="10" Padding="14" Margin="0,12,0,8">
            <StackPanel>
                <TextBlock Text="LIVE AD / POP-UP INVESTIGATION" FontWeight="SemiBold" Foreground="#60A5FA"/>
                <TextBlock Text="While the unwanted ad is visible on the phone, tap Who Is Showing This Ad? This reports the focused window owner—not necessarily the ad provider. Watch for 15 seconds to collect changing foreground activity."
                           Foreground="#B3C5DA" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,7"/>
                <TextBlock x:Name="ForegroundText" Text="No foreground observation yet." TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,4,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource ToolButton}" Background="#334155" Click="Close_Click" Margin="0"/>
            <TextBlock Text="Review findings and device observations with the owner before uninstalling any app."
                       Foreground="#7F97B2" FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>