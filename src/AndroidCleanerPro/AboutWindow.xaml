<Window x:Class="AndroidCleanerPro.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Android Cleaner Pro" Width="640" Height="525"
        MinWidth="540" MinHeight="460" WindowStartupLocation="CenterOwner"
        Background="#0B1220" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2E8F0"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#10213A" Padding="30,25">
            <StackPanel>
                <TextBlock Text="◈  ANDROID CLEANER PRO" Foreground="#60A5FA"
                           FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="Technician Edition" FontSize="29" FontWeight="Bold" Margin="0,9,0,0"/>
                <TextBlock x:Name="VersionText" Text="Version" Foreground="#94A3B8" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,22">
                <TextBlock Text="Android device diagnostics and suspicious-app review for Windows repair technicians."
                           TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"/>
                <Border Background="#17263B" CornerRadius="11" Padding="16" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="About this application" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,9"/>
                        <TextBlock x:Name="RuntimeText" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <TextBlock Text="Platform: Microsoft Windows • WPF desktop application" TextWrapping="Wrap"/>
                        <TextBlock Text="Android connection: Google Android Debug Bridge (ADB)" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#17263B" CornerRadius="11" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Links and resources" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,9"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Hyperlink NavigateUri="https://github.com/Brcak/Android-Cleaner-Pro"
                                       RequestNavigate="Link_RequestNavigate" Foreground="#93C5FD">Source repository</Hyperlink>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Hyperlink NavigateUri="https://github.com/Brcak/Android-Cleaner-Pro/releases/latest"
                                       RequestNavigate="Link_RequestNavigate" Foreground="#93C5FD">Latest Windows release</Hyperlink>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            <Hyperlink NavigateUri="https://developer.android.com/tools/adb"
                                       RequestNavigate="Link_RequestNavigate" Foreground="#93C5FD">Android Debug Bridge documentation</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Text="Safety: This is an experimental diagnostic tool, not a certified antivirus. Review indicators are not proof of malware. Work only on devices with the owner's authorization."
                           Foreground="#A2B4CC" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#111E32" Padding="20,12" BorderBrush="#283B56" BorderThickness="0,1,0,0">
            <Button HorizontalAlignment="Right" Content="Close" Padding="20,9"
                    Background="#334155" Foreground="White" BorderThickness="0" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>