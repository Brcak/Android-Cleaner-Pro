<Window x:Class="AndroidCleanerPro.LogcatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Log Viewer | Android Cleaner Pro" Width="1100" Height="730"
        MinWidth="800" MinHeight="550" WindowStartupLocation="CenterOwner"
        Background="#0B1220" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2E8F0"/></Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,17">
            <TextBlock Text="ANDROID LOG VIEWER" Foreground="#60A5FA" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Logcat Diagnostics" FontSize="26" FontWeight="Bold" Margin="0,6,0,4"/>
            <TextBlock x:Name="DeviceLabel" Foreground="#94A3B8"/>
            <TextBlock Text="Manual snapshots only. Logs may contain customer data; inspect them before exporting or sharing."
                       Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" Content="Read Latest 500 Lines"
                    Style="{StaticResource ToolButton}" Click="Refresh_Click"/>
            <Button Content="Save Visible Logs" Background="#0F766E"
                    Style="{StaticResource ToolButton}" Click="Save_Click"/>
            <StackPanel Margin="0,0,12,7">
                <TextBlock Text="Severity" FontSize="11" Foreground="#94A3B8"/>
                <ComboBox x:Name="SeverityBox" Width="124" Height="28" SelectedIndex="0"
                          SelectionChanged="Filter_Changed" Background="#F8FAFC" Foreground="#0F172A">
                    <ComboBoxItem Content="All lines"/>
                    <ComboBoxItem Content="Warnings + Errors"/>
                    <ComboBoxItem Content="Errors only"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,10,7">
                <TextBlock Text="Search text" FontSize="11" Foreground="#94A3B8"/>
                <TextBox x:Name="SearchBox" Width="225" Height="28" Padding="7,2"
                         Background="#F8FAFC" Foreground="#0F172A" TextChanged="Search_Changed"/>
            </StackPanel>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="LogText" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="NoWrap" Background="#071321"
                     Foreground="#DDE9F8" BorderBrush="#344D6A" Padding="12"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="StatusText" Grid.Row="1"
                       Text="No snapshot yet. Click Read Latest 500 Lines."
                       Foreground="#94A3B8" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click"
                    Style="{StaticResource ToolButton}" Background="#334155" Margin="0"/>
            <TextBlock Text="Logcat is not proof of malware. Some newer Android builds restrict accessible log entries."
                       VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#9BB2CD"/>
        </DockPanel>
    </Grid>
</Window>