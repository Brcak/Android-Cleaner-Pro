<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AndroidCleanerPro</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="Exists('Assets/platform-tools.zip')">
    <EmbeddedResource Include="Assets/platform-tools.zip" LogicalName="AndroidCleanerPro.PlatformTools.zip" />
  </ItemGroup>
</Project>