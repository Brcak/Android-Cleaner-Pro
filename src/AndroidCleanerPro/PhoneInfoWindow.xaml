<Window x:Class="AndroidCleanerPro.PhoneInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Information | Android Cleaner Pro"
        Width="1000" Height="790" MinWidth="760" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="#0B1220" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#162439"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="19"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#101D31" Padding="28,22" BorderBrush="#21324B" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="DEVICE INFORMATION" FontSize="11" Foreground="#60A5FA" FontWeight="Bold"/>
                <TextBlock x:Name="DeviceTitle" Text="Connected Android phone" FontSize="28" FontWeight="Bold" Margin="0,7,0,4"/>
                <TextBlock x:Name="DeviceSubtitle" Text="Reading device details..." FontSize="13" Foreground="#94A3B8"/>
                <UniformGrid Columns="4" Margin="0,20,0,0">
                    <Border Background="#1B3150" CornerRadius="9" Padding="14" Margin="0,0,9,0">
                        <StackPanel><TextBlock Text="MODEL NUMBER" FontSize="10" Foreground="#93B4DB"/><TextBlock x:Name="ModelSummary" Text="—" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Border>
                    <Border Background="#1B3150" CornerRadius="9" Padding="14" Margin="0,0,9,0">
                        <StackPanel><TextBlock Text="ANDROID" FontSize="10" Foreground="#93B4DB"/><TextBlock x:Name="AndroidSummary" Text="—" FontWeight="SemiBold" FontSize="16"/></StackPanel>
                    </Border>
                    <Border Background="#1B3150" CornerRadius="9" Padding="14" Margin="0,0,9,0">
                        <StackPanel><TextBlock Text="BATTERY" FontSize="10" Foreground="#93B4DB"/><TextBlock x:Name="BatterySummary" Text="—" FontWeight="SemiBold" FontSize="16"/></StackPanel>
                    </Border>
                    <Border Background="#1B3150" CornerRadius="9" Padding="14">
                        <StackPanel><TextBlock Text="STORAGE" FontSize="10" Foreground="#93B4DB"/><TextBlock x:Name="StorageSummary" Text="—" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,22,12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="Device Identity" Style="{StaticResource CardHeading}"/>
                                <StackPanel x:Name="IdentityRows"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="Android &amp; Firmware" Style="{StaticResource CardHeading}"/>
                                <StackPanel x:Name="SoftwareRows"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="Display" Style="{StaticResource CardHeading}"/>
                                <StackPanel x:Name="DisplayRows"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="Battery &amp; Charging" Style="{StaticResource CardHeading}"/>
                                <StackPanel x:Name="BatteryRows"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="Hardware &amp; Memory" Style="{StaticResource CardHeading}"/>
                                <StackPanel x:Name="HardwareRows"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="Internal Storage" Style="{StaticResource CardHeading}"/>
                                <StackPanel x:Name="StorageRows"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Background="#162439" CornerRadius="13" Padding="19" Margin="0,1,14,14">
                    <StackPanel>
                        <TextBlock Text="IMEI 1 &amp; IMEI 2" Style="{StaticResource CardHeading}"/>
                        <TextBlock Text="Android 10+ generally restricts IMEI access through ordinary ADB. These optional fields are for manual entry from the owner's phone (dial *#06# or use Settings → About phone). Values are held only in this window, never automatically saved or sent to a server." TextWrapping="Wrap" Foreground="#9DB1C9" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IMEI 1 — manual" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="ImeiOne" Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#38526F" Padding="10,9" FontSize="14" MaxLength="20" ToolTip="Enter IMEI 1 manually if authorized by device owner"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IMEI 2 — manual" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="ImeiTwo" Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#38526F" Padding="10,9" FontSize="14" MaxLength="20" ToolTip="Enter IMEI 2 manually if supported by device"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#21324B" BorderThickness="0,1,0,0" Padding="24,14" Background="#101D31">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource ActionButton}" Background="#34465F" Click="Close_Click"/>
                <Button DockPanel.Dock="Right" Content="Copy device summary" Style="{StaticResource ActionButton}" Margin="0,0,12,0" Click="Copy_Click"/>
                <TextBlock Text="Read-only diagnostics • manually entered IMEIs are excluded from copied summaries" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>