<Window x:Class="AndroidCleanerPro.RepairCasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repair Records | Android Cleaner Pro" Width="1080" Height="800"
        MinWidth="830" MinHeight="600" WindowStartupLocation="CenterOwner"
        Background="#0B1220" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2E8F0"/></Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="REPAIR SHOP WORKFLOW" Foreground="#60A5FA" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Device Repair Records" FontSize="26" FontWeight="Bold" Margin="0,5,0,3"/>
            <TextBlock Text="Private local notes and printable before/after summaries. Avoid entering customer passwords, IMEIs or unnecessary personal information."
                       Foreground="#FBBF24" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#162439" CornerRadius="12" Padding="14" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Saved Repair Jobs" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Button Content="New Repair Job" Style="{StaticResource ToolButton}"
                                Click="New_Click" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <ListBox x:Name="JobsList" SelectionChanged="JobsList_SelectionChanged"
                             Background="#0B1729" Foreground="#F8FAFC"
                             DisplayMemberPath="Ticket"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="#162439" CornerRadius="12" Padding="17">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Job reference / ticket" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TicketBox" Background="#0B1729" Foreground="White"
                                 BorderBrush="#3F5370" Padding="9" Margin="0,0,0,10"/>
                        <TextBlock Text="Device model (optional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ModelBox" Background="#0B1729" Foreground="White"
                                 BorderBrush="#3F5370" Padding="9" Margin="0,0,0,10"/>
                        <TextBlock Text="Customer-reported issue (before service)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ProblemBox" Background="#0B1729" Foreground="White" Height="75"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 BorderBrush="#3F5370" Padding="9" Margin="0,0,0,10"/>
                        <TextBlock Text="Diagnosis and evidence" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="DiagnosisBox" Background="#0B1729" Foreground="White" Height="75"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 BorderBrush="#3F5370" Padding="9" Margin="0,0,0,10"/>
                        <TextBlock Text="Work performed / apps removed" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="WorkBox" Background="#0B1729" Foreground="White" Height="75"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 BorderBrush="#3F5370" Padding="9" Margin="0,0,0,10"/>
                        <TextBlock Text="Final result / after-service notes" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ResultBox" Background="#0B1729" Foreground="White" Height="75"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 BorderBrush="#3F5370" Padding="9" Margin="0,0,0,13"/>
                        <WrapPanel>
                            <Button Content="Save Job" Style="{StaticResource ToolButton}" Click="Save_Click"/>
                            <Button Content="Export Customer Report (.html)" Style="{StaticResource ToolButton}"
                                    Background="#0F766E" Click="Export_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="StatusText" Foreground="#9BB2CD" TextWrapping="Wrap"
                                   Text="Select a job or create a new one."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource ToolButton}"
                    Background="#334155" Click="Close_Click" Margin="0"/>
            <TextBlock Text="Data is saved only on this computer. Report HTML can be printed to PDF from a browser."
                       VerticalAlignment="Center" Foreground="#93A9C3" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>